# Echolens environment variables.
#
# The prototype runs fully on deterministic mock data and the mock AI
# provider — no environment variables are required to run it.
#
# Optional: configure a real LLM provider. All AI calls are isolated
# behind lib/ai, so switching providers never touches the UI.
#
# LLM_PROVIDER=mock          # "mock" | "openai" | "anthropic"
# LLM_API_KEY=               # provider API key
# LLM_MODEL=                 # provider model name
